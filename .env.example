# Copy to .env and fill in your keys. Never commit .env.

# --- LLM provider keys for chatbot-service (port 8087) ---
# Auto-detection order: OpenAI -> Anthropic -> Gemini (first non-empty key wins).
# At least one is required for the chat assistant to answer.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Database ---
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password

# --- Auth ---
JWT_SECRET=your-secret-key-change-in-production

# --- Monitoring ---
# Grafana admin password (default: admin)
GRAFANA_ADMIN_PASSWORD=admin
