# Copy to .env and fill in your keys. Never commit .env.

# --- LLM provider keys for chatbot-service (port 8087) ---
# Auto-detection order: OpenAI -> Anthropic -> Gemini (first non-empty key wins).
# At least one is required for the chat assistant to answer.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Database ---
# All services use the APP_DB_* variables below (Supabase Postgres).

# --- Auth ---
# Must be a long random secret (>= 32 chars), e.g. `openssl rand -base64 48`.
# The same value is required by auth-service, gateway, and every backend service.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# --- Monitoring ---
# Set a strong local Grafana admin password.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# --- Application database ---
# All backend services + agent-service read from these. Point at Supabase:
APP_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
APP_DB_HOST=aws-0-<region>.pooler.supabase.com
APP_DB_PORT=6543
APP_DB_NAME=postgres
APP_DB_USERNAME=postgres.<project-ref>
APP_DB_PASSWORD=CHANGE_ME_SUPABASE_DB_PASSWORD
APP_DB_SSLMODE=require
# To use the bundled local postgres container instead, set:
#   APP_DB_URL=jdbc:postgresql://postgres:5432/finance_tracker
#   APP_DB_USERNAME=finance_user
#   APP_DB_PASSWORD=<same as POSTGRES_PASSWORD>
#   APP_DB_HOST=postgres  APP_DB_PORT=5432  APP_DB_NAME=finance_tracker
#   APP_DB_SSLMODE=prefer
